# Optional TURN servers for restrictive NATs. Values are exposed to browsers.
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"turn:your-host:3478","username":"short-lived-user","credential":"short-lived-secret"}]

# Neon PostgreSQL connection string:
DATABASE_URL=postgresql://neondb_owner:password@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth secret and site URLs:
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# Optional social login providers:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# VERCEL_CLIENT_ID=
# VERCEL_CLIENT_SECRET=
