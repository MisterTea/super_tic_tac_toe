# Optional TURN servers for restrictive NATs. Values are exposed to browsers.
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"turn:your-host:3478","username":"short-lived-user","credential":"short-lived-secret"}]

# Set by `npx convex dev` locally; set public URLs in Vercel for production.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Configure these on the Convex deployment, not in browser code:
# SITE_URL=https://super-tic-tac-toe-royale.vercel.app
# TRUSTED_ORIGINS=https://super-tic-tac-toe-royale.vercel.app
# BETTER_AUTH_SECRET=<cryptographically random 32-byte secret>
# GOOGLE_CLIENT_ID=<Google OAuth client ID>
# GOOGLE_CLIENT_SECRET=<Google OAuth client secret>
# VERCEL_CLIENT_ID=<Sign in with Vercel client ID>
# VERCEL_CLIENT_SECRET=<Sign in with Vercel client secret>
