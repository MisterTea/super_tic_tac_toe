{
  "name": "ultimate-relay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-ort.mjs",
    "export:ai": "python training/export_browser.py && python training/generate_browser_fixtures.py && node scripts/copy-ort.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test tests/game.test.ts tests/skill.test.ts tests/timing.test.ts tests/royale.test.ts",
    "test:backend": "vitest run tests/convex.test.ts",
    "backend:dev": "convex dev",
    "backend:deploy": "convex deploy",
    "test:parity": "tsx --test tests/parity.test.ts tests/policy.test.ts tests/skill-parity.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app lib tests e2e *.json *.ts"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "@noble/hashes": "^2.4.0",
    "better-auth": "1.6.33",
    "convex": "^1.46.0",
    "next": "^16.0.0",
    "nostr-tools": "^2.17.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
    "@next/env": "^16.3.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "convex-test": "^0.0.60",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  }
}
