{
  "name": "ultimate-relay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-ort.mjs",
    "export:ai": "python training/export_browser.py && python training/generate_browser_fixtures.py && node scripts/copy-ort.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test tests/game.test.ts tests/skill.test.ts tests/timing.test.ts",
    "test:parity": "tsx --test tests/parity.test.ts tests/policy.test.ts tests/skill-parity.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app lib tests e2e *.json *.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "nostr-tools": "^2.17.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "ws": "^8.22.0"
  }
}
